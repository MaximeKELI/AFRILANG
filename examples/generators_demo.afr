// Générateurs : yield des valeurs une à une
// Voir docs : /docs/iteration/

generator function compteur(n number) returns list number
    create i number = 0
    while i is less than n do
        yield i
        set i = i + 1
    end
end

say "Compteur 0..4 :"
for each v in compteur(5) do
    say v
end

generator function odds(n number) returns list number
    create i number = 1
    while i is less than n do
        yield i
        set i = i + 2
    end
end

say "Impairs :"
for each s in odds(10) do
    say s
end
