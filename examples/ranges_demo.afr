// Plages numériques : 1..n (inclusif) et 1..<n (exclusif)
// Voir docs : /docs/iteration/

say "Inclusif 1..5 :"
for each x in 1..5 do
    say x
end

say "Exclusif 1..<5 :"
create total number = 0
for each x in 1..<5 do
    set total = total + x
    say x
end
say total

create xs = 1..3
say "liste 1..3 :"
say xs at 0
say xs at 1
say xs at 2
