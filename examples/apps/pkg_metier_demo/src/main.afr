// Demo packages metier (subset composable offline)

import "pkg/geox/geox.afr"
use geox
import "pkg/httpx/httpx.afr"
use httpx
import "pkg/webapi/webapi.afr"
use webapi
import "pkg/deployx/deployx.afr"
use deployx
import "pkg/datax/datax.afr"
use datax

say "=== geox ==="
create km = distanceKm(6.1319, 1.2228, 5.6037, -0.1870)
say "Lome->Accra ~ {km} km"

say "=== httpx ==="
create url = withQuery("https://api.example/v1/markets", "city", "Lome")
say url
say object1("amount", "5000")

say "=== webapi ==="
create router = makeHealthRouter()
say get(router, "/health")

say "=== deployx ==="
say healthUrl("https://app.example")
say procfileWeb("./server")

say "=== datax ==="
say firstField("ville,pop")
say "metier packages demo OK"
