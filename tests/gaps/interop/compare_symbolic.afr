// Symbolic comparisons alongside natural language forms
test "symbolic compare"
    create a = 3
    assert a > 2
    assert a >= 3
    assert a < 4
    assert a <= 3
    assert a == 3
    assert a != 4
end

test "natural parity"
    create a = 3
    assert a is greater than 2
    assert a is greater than or equal to 3
    assert a is less than 4
    assert a is less than or equal to 3
    assert a is equal to 3
    assert a is not equal to 4
end
