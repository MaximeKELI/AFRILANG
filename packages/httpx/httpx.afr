import "std/http"
import "std/json"
import "std/str"

use http
use json
use str

module httpx
    function httpxEscapeJson(s text) returns text
        create step1 = replace(s, "\\", "\\\\")
        return replace(step1, "\"", "\\\"")
    end

    function bearerHeader(token text) returns text
        if token is equal to "" then
            return ""
        end
        return "Authorization: Bearer " + token + "\n"
    end

    function jsonHeaders() returns text
        return "Content-Type: application/json\nAccept: application/json\n"
    end

    function jsonAuthHeaders(token text) returns text
        return jsonHeaders() + bearerHeader(token)
    end

    function withQuery(url text, key text, value text) returns text
        if contains(url, "?") then
            return url + "&" + key + "=" + value
        end
        return url + "?" + key + "=" + value
    end

    function object1(key text, value text) returns text
        return "{\"" + httpxEscapeJson(key) + "\":\"" + httpxEscapeJson(value) + "\"}"
    end

    function object2(k1 text, v1 text, k2 text, v2 text) returns text
        return "{\"" + httpxEscapeJson(k1) + "\":\"" + httpxEscapeJson(v1) + "\",\"" + httpxEscapeJson(k2) + "\":\"" + httpxEscapeJson(v2) + "\"}"
    end


    function getText(url text) returns text
        return httpGet(url)
    end

    function getJson(url text) returns json
        create raw = httpGet(url)
        if raw is equal to "" then
            return parse("{}")
        end
        return parse(raw)
    end

    function postJson(url text, body text) returns text
        return httpPostHeaders(url, body, jsonHeaders())
    end

    function postJsonAuth(url text, token text, body text) returns text
        return httpPostHeaders(url, body, jsonAuthHeaders(token))
    end

    function postForm(url text, formBody text) returns text
        create headers text = "Content-Type: application/x-www-form-urlencoded\n"
        return httpPostHeaders(url, formBody, headers)
    end

    function getStringField(responseText text, key text) returns text
        if responseText is equal to "" then
            return ""
        end
        create doc json = parse(responseText)
        return getString(doc, key)
    end

    function getBoolField(responseText text, key text) returns bool
        if responseText is equal to "" then
            return false
        end
        create doc json = parse(responseText)
        return getBool(doc, key)
    end

    function looksLikeJson(text text) returns bool
        create t = trim(text)
        // "{{" → literal "{" (interpolation escape)
        if startsWith(t, "{{") then
            return true
        end
        return startsWith(t, "[")
    end
end
